# Docker host binding; the container listens on the address in config/docker.json.
CHRONICLE_BIND=127.0.0.1
CHRONICLE_PORT=8080
CHRONICLE_CONTAINER_PORT=8080
CHRONICLE_CONFIG_FILE=./config/docker.json

# Existing host research is mounted at /data. Match id -u and id -g on the host.
CHRONICLE_WORKSPACE_HOST=./.chronicle
CHRONICLE_UID=1000
CHRONICLE_GID=1000

# Uncomment only values you want to override from JSON or saved Settings.
# CHRONICLE_ADDR=0.0.0.0:8080
# CHRONICLE_WORKSPACE=/data
# CHRONICLE_STATIC_DIR=/app/web/build
# CHRONICLE_ALLOWED_ORIGINS=https://chronicle.example.org
# CHRONICLE_GEOCODER_URL=https://photon.komoot.io/api/
# CHRONICLE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# CHRONICLE_MAP_ATTRIBUTION=OpenStreetMap contributors

# Optional PostgreSQL service: enable profile and select its database.
# COMPOSE_PROFILES=postgres
# POSTGRES_DB=chronicle
# POSTGRES_USER=chronicle
# POSTGRES_PASSWORD=choose-a-password
# DATABASE_URL=postgres://chronicle:choose-a-password@postgres:5432/chronicle?sslmode=disable

# Optional Ollama service: enable the profile and pull your chosen model.
# COMPOSE_PROFILES=ollama
# CHRONICLE_LLM_PROVIDER=ollama
# CHRONICLE_LLM_URL=http://ollama:11434
# OLLAMA_HOST=0.0.0.0:11434
# CHRONICLE_LLM_MODEL=your-installed-model
# CHRONICLE_LLM_API_KEY=
# CHRONICLE_MCP_URL=http://host.docker.internal:3000/mcp
# CHRONICLE_SEARCH_TOOL=your_search_tool
# CHRONICLE_RETRIEVE_TOOL=your_retrieval_tool
# CHRONICLE_MAX_REQUESTS=40
# CHRONICLE_CONCURRENCY=2

# Google speech credentials: use compose.speech.yaml to mount this host file.
# GOOGLE_ADC_FILE=/absolute/host/path/to/credentials.json
# GOOGLE_CLOUD_QUOTA_PROJECT=your-google-project
# CHRONICLE_SPEECH_URL=https://texttospeech.googleapis.com/v1

# ElevenLabs speech: detected automatically by Voice & playback.
# ELEVENLABS_API_KEY=
# CHRONICLE_ELEVENLABS_URL=https://api.elevenlabs.io

# Local Vite development only.
# CHRONICLE_DEV_HOST=127.0.0.1
# CHRONICLE_DEV_PORT=5173
# CHRONICLE_DEV_API_URL=http://127.0.0.1:8080
