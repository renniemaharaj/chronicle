{
  "name": "chronicle",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "go run ./cmd/chronicle",
    "build": "npm --prefix web run build && go build -o .chronicle/bin/chronicle ./cmd/chronicle",
    "check": "node scripts/check-lines.mjs && npm run format:check && npm --prefix web run check",
    "test": "go test -race ./... && npm --prefix web test",
    "test:browser": "npm --prefix web run test:browser",
    "format": "node scripts/readable-javascript.mjs && prettier --write 'web/**/*.{ts,svelte,css,js}' 'scripts/*.mjs' '*.json' && go run ./tools/readable-go",
    "format:check": "node scripts/readable-javascript.mjs --check && prettier --check 'web/**/*.{ts,svelte,css,js}' 'scripts/*.mjs' '*.json' && go run ./tools/readable-go --check"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
